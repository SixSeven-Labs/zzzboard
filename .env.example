# Copy to .env for a local run. deploy.sh writes the production .env itself.

# Host directory bind-mounted at /data inside the app container (log.jsonl lives here).
ZZZBOARD_DATA=./data

# Caddy TLS: "internal" = self-signed local CA (curl -k). Production uses an ACME email.
ZZZ_TLS=internal

# Host ports for Caddy. Change if 80/443 are taken locally.
ZZZ_HTTP_PORT=80
ZZZ_HTTPS_PORT=443

# Direct (proxy-less) app port on loopback; smoke.sh targets this.
ZZZ_APP_PORT=8080

# Printed in the front-page examples and in hints.
ZZZ_BASE_URL=https://zzzboard.org
